FROM apache/airflow:2.7.3-python3.11

USER root

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec sed -i \
        -e 's|apt.postgresql.org/pub/repos/apt|apt-archive.postgresql.org/pub/repos/apt|g' \
        -e 's|http://deb.debian.org/debian-security|https://archive.debian.org/debian-security|g' \
        -e 's|https://deb.debian.org/debian-security|https://archive.debian.org/debian-security|g' \
        -e 's|http://deb.debian.org/debian|https://deb.debian.org/debian|g' \
        {} + \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get update \
    && apt-get install -y --no-install-recommends git \
    && git --version \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/dbt-venv \
    && chown airflow:0 /opt/dbt-venv

USER airflow

RUN python -m venv /opt/dbt-venv \
    && PIP_USER=false /opt/dbt-venv/bin/python -m pip install --upgrade pip \
    && PIP_USER=false /opt/dbt-venv/bin/python -m pip install --no-cache-dir \
        "dbt-core==1.12.5" \
        "dbt-athena==1.11.1" \
    && /opt/dbt-venv/bin/python -m pip check